{
    "extends": "@react-native/typescript-config/tsconfig.json",
    "compilerOptions": {
        "target": "esnext",
        "lib": [
            "esnext",
            "dom"
        ],
        "baseUrl": ".",
        "jsx": "react-native",
        "moduleResolution": "node",
        "skipLibCheck": true,
        "paths": {
            "@api/*": [
                "src/api/*"
            ],
            "@components/*": [
                "src/components/*"
            ],
            "@screens/*": [
                "src/screens/*"
            ],
            "@utils/*": [
                "src/utils/*"
            ]
        }
    }
}