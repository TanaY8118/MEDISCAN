# MediScan Environment Variables Template
# Copy this file to .env and fill in the actual values

# Server Configuration
SERVER_PORT=8080
LOG_LEVEL_COM_MEDISCAN=INFO
SHOW_SQL=false

# MySQL Configuration
# Use 'localhost' for local execution, 'mysql' for docker-compose
MYSQL_URL=jdbc:mysql://localhost:3306/mediscan
MYSQL_USER=mediscan_user
MYSQL_PASSWORD=mediscan_password
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=mediscan

# Migration User
MYSQL_MIGRATOR_USER=mediscan_user
MYSQL_MIGRATOR_PASSWORD=mediscan_password

# MongoDB Configuration
# Use 'localhost' for local execution, 'mongodb' for docker-compose
MONGO_URI=mongodb://root:rootpassword@localhost:27017/mediscan?authSource=admin
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=rootpassword

# JWT Configuration
# Generate a secure 256-bit key for production
JWT_SECRET=replace_with_a_secure_64_character_hex_string
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
