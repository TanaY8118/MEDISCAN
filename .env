# MySQL Configuration (Development Defaults)
MYSQL_URL=jdbc:mysql://localhost:3306/mediscan
MYSQL_USER=mediscan_user
MYSQL_PASSWORD=mediscan_password

# Migration User (Same as runtime for local dev)
MYSQL_MIGRATOR_USER=mediscan_user
MYSQL_MIGRATOR_PASSWORD=mediscan_password

# MongoDB Configuration
MONGO_URI=mongodb://root:rootpassword@localhost:27017/mediscan?authSource=admin

# JWT Configuration (Security-compliant key)
JWT_SECRET=4e6a625a655468576d5a7134743777217a25432a462d4a614e645267556a586e
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Server & App Config
SERVER_PORT=8080
SHOW_SQL=true
LOG_LEVEL_COM_MEDISCAN=DEBUG

# Docker Infrastructure Setup
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=mediscan
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=rootpassword

